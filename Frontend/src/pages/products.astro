---
import Layout from '../layouts/Layout.astro';
import { productGroups } from '../data/products';

const CLIENT_KEY = import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY;

const categories = [
  "All",
  "Raw Material",
  "Dry Slices",
  "Grind",
  "Powder",
  "Extract Liquid",
  "Extract Powder",
  "Aromatic Water",
  "Oil"
];
---

<Layout title="Katalog Produk - Magna Ingredients">

  <!-- Midtrans Snap SDK -->
  <script
    src="https://app.midtrans.com/snap/snap.js"
    data-client-key={CLIENT_KEY}
  ></script>

  <main class="products-page">

    <!-- =========================================
         KATALOG PRODUK
    ========================================== -->
    <section class="catalog-section">
      <div class="container">

        <!-- TOOLBAR -->
        <div class="catalog-toolbar">

          <div class="currency-group">
            <label for="currency-select">Mata Uang:</label>

            <select id="currency-select">
              <option value="IDR">IDR (Rupiah - Indonesia)</option>
              <option value="USD">USD ($ - Export)</option>
              <option value="AED">AED (Emirates Dirham)</option>
              <option value="EUR">EUR (€ - Euro)</option>
            </select>
          </div>

          <button id="open-cart-btn" class="cart-trigger">

            <svg
              class="icon-cart-header"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>

            <span>
              Keranjang (<strong id="cart-count">0</strong>)
            </span>

          </button>

        </div>


        <!-- =========================================
             FILTER KATEGORI
        ========================================== -->
        <div class="category-filter-container">

          <div class="category-pills">

            {categories.map((cat, idx) => (
              <button
                class={`category-btn ${idx === 0 ? 'active' : ''}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}

          </div>

        </div>


        <!-- =========================================
             PRODUCT GRID
        ========================================== -->
        <div class="product-grid" id="product-grid">

          {productGroups.map((group) => (

            <div
              class="product-card"
              id={`card-${group.id}`}
              data-category={group.category || 'Raw Material'}
            >

              <!-- GAMBAR PRODUK -->
              <div class="product-image-wrapper">

                <span class="badge-grade">
                  {group.grade}
                </span>

                <img
                  src={group.imageUrl || '/images/products/placeholder.jpg'}
                  alt={group.name}
                  class="product-image"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/images/products/placeholder.jpg';"
                />

              </div>


              <!-- KONTEN PRODUK -->
              <div class="product-content">

                <div class="spec-tag">
                  {group.category || group.spec}
                </div>


                <!-- NAMA PRODUK -->
                <h3 class="product-title">
                  {group.name}
                </h3>


                <!-- PILIHAN KEMASAN -->
                <div class="size-selection-area">

                  <span class="size-label">
                    Kemasan:
                  </span>

                  <div class="size-pills">

                    {group.variants.map((v, idx) => (

                      <button
                        class={`size-pill ${idx === 0 ? 'active' : ''}`}
                        data-group-id={group.id}
                        data-index={idx}
                      >
                        {v.size}
                      </button>

                    ))}

                  </div>

                </div>


                <!-- HARGA + CART -->
                <div class="price-cart-footer">

                  <div class="price-box">

                    <span class="price-subtext">
                      Harga:
                    </span>

                    <div
                      class="price-value"
                      id={`price-${group.id}`}
                    >
                      Rp {group.variants[0].priceIDR.toLocaleString('id-ID')}
                    </div>

                  </div>


                  <button
                    class="btn-add-cart-icon"
                    data-group-id={group.id}
                    title="Tambah ke Keranjang"
                    aria-label={`Tambah ${group.name} ke keranjang`}
                  >

                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>

                  </button>

                </div>

              </div>

            </div>

          ))}

        </div>

      </div>
    </section>


    <!-- =========================================
         OVERLAY
    ========================================== -->
    <div id="cart-overlay" class="cart-overlay"></div>


    <!-- =========================================
         SIDEBAR KERANJANG
    ========================================== -->
    <aside
      id="cart-sidebar"
      class="cart-sidebar"
      aria-label="Keranjang Belanja"
    >

      <!-- HEADER CART -->
      <div class="cart-header">

        <div class="cart-header-title">

          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>

          <div>
            <h3>Keranjang Belanja</h3>
            <span id="cart-header-count">
              0 produk
            </span>
          </div>

        </div>


        <button
          id="close-cart-btn"
          class="close-btn"
          aria-label="Tutup keranjang"
        >
          &times;
        </button>

      </div>


      <!-- BODY CART -->
      <div id="cart-items" class="cart-body">

        <div class="empty-cart-state">

          <div class="empty-cart-icon">

            <svg
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>

          </div>

          <h4>Keranjang masih kosong</h4>

          <p>
            Tambahkan produk yang ingin Anda beli.
          </p>

        </div>

      </div>


      <!-- FOOTER CART -->
      <div class="cart-footer">

        <div class="cart-summary-row">

          <div>
            <span class="summary-label">
              Total Pembayaran
            </span>

            <span class="summary-note">
              Belum termasuk biaya tambahan
            </span>
          </div>

          <span
            id="cart-total-price"
            class="summary-amount"
          >
            Rp 0
          </span>

        </div>


        <button
          id="pay-button"
          class="checkout-btn"
        >
          Bayar Langsung Sekarang
        </button>

      </div>

    </aside>

  </main>

</Layout>


<script>
  import { productGroups } from '../data/products';

  let cart = [];
  let currentCurrency = 'IDR';
  let selectedVariantsState = {};


  /* =========================================
     DEFAULT VARIANT
  ========================================== */

  productGroups.forEach((g) => {
    selectedVariantsState[g.id] = 0;
  });


  /* =========================================
     FORMAT PRICE
  ========================================== */

  function formatPrice(val, curr) {

    if (curr === 'IDR') {
      return `Rp ${val.toLocaleString('id-ID')}`;
    }

    if (curr === 'USD') {
      return `$ ${val.toFixed(2)}`;
    }

    if (curr === 'AED') {
      return `${val.toFixed(2)} AED`;
    }

    if (curr === 'EUR') {
      return `€ ${val.toFixed(2)}`;
    }

    return `${val}`;
  }


  /* =========================================
     GET VARIANT PRICE
  ========================================== */

  function getVariantPrice(variant, curr) {

    if (curr === 'USD') {
      return variant.priceUSD;
    }

    if (curr === 'AED') {
      return variant.priceAED;
    }

    if (curr === 'EUR') {
      return variant.priceEUR;
    }

    return variant.priceIDR;
  }


  /* =========================================
     UPDATE PRODUCT CARD PRICE
  ========================================== */

  function updateCardPriceUI(groupId) {

    const group = productGroups.find(
      (g) => g.id === groupId
    );

    if (!group) return;

    const variantIndex =
      selectedVariantsState[groupId];

    const selectedVariant =
      group.variants[variantIndex];

    const priceDisplayEl =
      document.getElementById(`price-${groupId}`);

    if (priceDisplayEl) {

      const priceVal =
        getVariantPrice(
          selectedVariant,
          currentCurrency
        );

      priceDisplayEl.innerText =
        formatPrice(
          priceVal,
          currentCurrency
        );
    }
  }


  /* =========================================
     FILTER CATEGORY
  ========================================== */

  document
    .querySelectorAll('.category-btn')
    .forEach((btn) => {

      btn.addEventListener('click', (e) => {

        const target =
          e.currentTarget as HTMLElement;

        const selectedCategory =
          target.dataset.category;

        document
          .querySelectorAll('.category-btn')
          .forEach((b) => {
            b.classList.remove('active');
          });

        target.classList.add('active');


        const productCards =
          document.querySelectorAll('.product-card');

        productCards.forEach((card) => {

          const cardCategory =
            (card as HTMLElement).dataset.category;

          if (
            selectedCategory === 'All' ||
            cardCategory === selectedCategory
          ) {

            (card as HTMLElement).style.display =
              'flex';

          } else {

            (card as HTMLElement).style.display =
              'none';

          }

        });

      });

    });


  /* =========================================
     VARIANT / KEMASAN
  ========================================== */

  document
    .querySelectorAll('.size-pill')
    .forEach((pill) => {

      pill.addEventListener('click', (e) => {

        const target =
          e.currentTarget as HTMLElement;

        const groupId =
          target.dataset.groupId;

        const index =
          parseInt(
            target.dataset.index || '0',
            10
          );

        const parentCard =
          target.closest('.product-card');

        parentCard
          ?.querySelectorAll('.size-pill')
          .forEach((btn) => {
            btn.classList.remove('active');
          });

        target.classList.add('active');

        selectedVariantsState[groupId] =
          index;

        updateCardPriceUI(groupId);

      });

    });


  /* =========================================
     CURRENCY
  ========================================== */

  document
    .getElementById('currency-select')
    ?.addEventListener('change', (e) => {

      currentCurrency =
        (e.target as HTMLSelectElement).value;

      productGroups.forEach((g) => {
        updateCardPriceUI(g.id);
      });

      updateCartUI();

    });


  /* =========================================
     ADD TO CART
  ========================================== */

  document
    .querySelectorAll('.btn-add-cart-icon')
    .forEach((btn) => {

      btn.addEventListener('click', (e) => {

        const target =
          e.currentTarget as HTMLElement;

        const groupId =
          target.dataset.groupId;

        const group =
          productGroups.find(
            (g) => g.id === groupId
          );

        if (!group) return;


        const variantIndex =
          selectedVariantsState[groupId];

        const variant =
          group.variants[variantIndex];


        const cartItemId =
          `${group.id}-${variant.size
            .replace(/\s+/g, '')
            .toLowerCase()}`;


        const existingIndex =
          cart.findIndex(
            (item) =>
              item.cartItemId === cartItemId
          );


        if (existingIndex > -1) {

          cart[existingIndex].qty += 1;

        } else {

          cart.push({

            cartItemId,

            name: group.name,

            spec: group.spec,

            category: group.category,

            size: variant.size,

            /* GAMBAR PRODUK */
            imageUrl:
              group.imageUrl ||
              '/images/products/placeholder.jpg',

            prices: {

              IDR: variant.priceIDR,

              USD: variant.priceUSD,

              AED: variant.priceAED,

              EUR: variant.priceEUR

            },

            qty: 1

          });

        }


        updateCartUI();

        openCart();

      });

    });


  /* =========================================
     CART DRAWER
  ========================================== */

  const cartSidebar =
    document.getElementById('cart-sidebar');

  const cartOverlay =
    document.getElementById('cart-overlay');


  function openCart() {

    cartSidebar?.classList.add('open');

    cartOverlay?.classList.add('open');

    document.body.classList.add(
      'cart-open'
    );
  }


  function closeCart() {

    cartSidebar?.classList.remove('open');

    cartOverlay?.classList.remove('open');

    document.body.classList.remove(
      'cart-open'
    );
  }


  document
    .getElementById('open-cart-btn')
    ?.addEventListener(
      'click',
      openCart
    );


  document
    .getElementById('close-cart-btn')
    ?.addEventListener(
      'click',
      closeCart
    );


  cartOverlay?.addEventListener(
    'click',
    closeCart
  );


  /* =========================================
     UPDATE CART
  ========================================== */

  function updateCartUI() {

    const cartCountEl =
      document.getElementById(
        'cart-count'
      );

    const cartHeaderCountEl =
      document.getElementById(
        'cart-header-count'
      );

    const cartItemsEl =
      document.getElementById(
        'cart-items'
      );

    const cartTotalPriceEl =
      document.getElementById(
        'cart-total-price'
      );


    /* TOTAL QUANTITY */

    const totalQty =
      cart.reduce(
        (sum, item) =>
          sum + item.qty,
        0
      );


    if (cartCountEl) {

      cartCountEl.innerText =
        totalQty.toString();

    }


    if (cartHeaderCountEl) {

      cartHeaderCountEl.innerText =
        `${totalQty} ${
          totalQty === 1
            ? 'produk'
            : 'produk'
        }`;

    }


    /* EMPTY CART */

    if (cart.length === 0) {

      if (cartItemsEl) {

        cartItemsEl.innerHTML = `

          <div class="empty-cart-state">

            <div class="empty-cart-icon">

              <svg
                width="42"
                height="42"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>

            </div>

            <h4>Keranjang masih kosong</h4>

            <p>
              Tambahkan produk yang ingin Anda beli.
            </p>

          </div>

        `;

      }


      if (cartTotalPriceEl) {

        cartTotalPriceEl.innerText =
          formatPrice(
            0,
            currentCurrency
          );

      }

      return;
    }


    /* =========================================
       RENDER ITEMS
    ========================================== */

    let itemsHTML = '';

    let grandTotal = 0;


    cart.forEach((item, index) => {

      const price =
        item.prices[currentCurrency];

      const itemSubtotal =
        price * item.qty;

      grandTotal += itemSubtotal;


      itemsHTML += `

        <div class="cart-item-row">

          <!-- GAMBAR -->
          <div class="cart-item-image">

            <img
              src="${
                item.imageUrl ||
                '/images/products/placeholder.jpg'
              }"
              alt="${item.name}"
              loading="lazy"
              onerror="
                this.onerror=null;
                this.src='/images/products/placeholder.jpg';
              "
            />

          </div>


          <!-- INFORMASI PRODUK -->
          <div class="cart-item-main">

            <!-- HEADER -->
            <div class="cart-item-head">

              <h4 class="cart-item-title">
                ${item.name}
              </h4>


              <button
                class="cart-item-remove"
                onclick="removeCartItem(${index})"
                title="Hapus produk"
                aria-label="Hapus produk"
              >
                &times;
              </button>

            </div>


            <!-- KATEGORI -->
            <div class="cart-item-spec">

              ${
                item.category ||
                item.spec ||
                ''
              }

            </div>


            <!-- KEMASAN -->
            <div class="cart-item-size">

              Kemasan:
              <strong>
                ${item.size}
              </strong>

            </div>


            <!-- BOTTOM -->
            <div class="cart-item-bottom">

              <!-- QUANTITY -->
              <div class="qty-stepper">

                <button
                  class="stepper-btn"
                  onclick="changeQty(${index}, -1)"
                  aria-label="Kurangi jumlah"
                >
                  −
                </button>


                <span class="stepper-val">
                  ${item.qty}
                </span>


                <button
                  class="stepper-btn"
                  onclick="changeQty(${index}, 1)"
                  aria-label="Tambah jumlah"
                >
                  +
                </button>

              </div>


              <!-- HARGA -->
              <div class="cart-item-price-group">

                <span class="unit-price">

                  ${formatPrice(
                    price,
                    currentCurrency
                  )} / pcs

                </span>


                <span class="subtotal-price">

                  ${formatPrice(
                    itemSubtotal,
                    currentCurrency
                  )}

                </span>

              </div>

            </div>

          </div>

        </div>

      `;

    });


    if (cartItemsEl) {

      cartItemsEl.innerHTML =
        itemsHTML;

    }


    if (cartTotalPriceEl) {

      cartTotalPriceEl.innerText =
        formatPrice(
          grandTotal,
          currentCurrency
        );

    }

  }


  /* =========================================
     CHANGE QUANTITY
  ========================================== */

  window.changeQty = (
    index,
    delta
  ) => {

    if (!cart[index]) return;

    cart[index].qty += delta;


    if (cart[index].qty <= 0) {

      cart.splice(index, 1);

    }


    updateCartUI();

  };


  /* =========================================
     REMOVE ITEM
  ========================================== */

  window.removeCartItem = (
    index
  ) => {

    if (!cart[index]) return;

    cart.splice(index, 1);

    updateCartUI();

  };


  /* =========================================
     MIDTRANS CHECKOUT
  ========================================== */

  const payButton =
    document.getElementById(
      'pay-button'
    );


  payButton?.addEventListener(
    'click',
    async () => {

      if (cart.length === 0) {

        alert(
          'Keranjang belanja Anda kosong!'
        );

        return;

      }


      const grandTotal =
        cart.reduce(
          (sum, item) =>
            sum +
            (
              item.prices[
                currentCurrency
              ] *
              item.qty
            ),
          0
        );


      /* MINIMUM TRANSAKSI IDR */

      if (
        currentCurrency === 'IDR' &&
        grandTotal < 10000
      ) {

        alert(
          'Minimal transaksi pembayaran via Midtrans adalah Rp 10.000'
        );

        return;

      }


      const orderPayload = {

        order_id:
          'MAGNA-' +
          Date.now(),

        gross_amount:
          Math.round(grandTotal),

        items:
          cart.map((item) => ({

            id:
              item.cartItemId,

            price:
              Math.round(
                item.prices[
                  currentCurrency
                ]
              ),

            quantity:
              item.qty,

            name:
              `${item.name} (${item.size})`
                .substring(0, 50)

          }))

      };


      payButton.innerText =
        'Memproses Pembayaran...';


      (
        payButton as HTMLButtonElement
      ).disabled = true;


      try {

        const res =
          await fetch(
            '/api/charge',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json'
              },

              body:
                JSON.stringify(
                  orderPayload
                )

            }
          );


        const data =
          await res.json();


        if (data.token) {

          // @ts-ignore
          window.snap.pay(
            data.token,
            {

              onSuccess:
                function () {

                  alert(
                    'Pembayaran Berhasil!'
                  );

                  cart = [];

                  updateCartUI();

                  closeCart();

                },


              onPending:
                function () {

                  alert(
                    'Selesaikan pembayaran Anda di popup yang muncul.'
                  );

                },


              onError:
                function () {

                  alert(
                    'Gagal memproses pembayaran!'
                  );

                },


              onClose:
                function () {

                  alert(
                    'Anda menutup jendela pembayaran.'
                  );

                }

            }
          );


        } else {

          alert(
            'Gagal mendapatkan token transaksi. Cek konfigurasi MIDTRANS_SERVER_KEY Anda.'
          );

          console.error(
            'API Response Error:',
            data
          );

        }


      } catch (err) {

        console.error(
          'Network/System Error:',
          err
        );

        alert(
          'Terjadi kesalahan koneksi ke server.'
        );


      } finally {

        payButton.innerText =
          'Bayar Langsung Sekarang';


        (
          payButton as HTMLButtonElement
        ).disabled = false;

      }

    }
  );
</script>


<style>

  /* =========================================
     VARIABLES
  ========================================== */

  :root {
    --primary: #1b4332;
    --primary-hover: #143225;
    --accent-green: #2d6a4f;
    --bg-page: #f8faf9;
    --text-main: #111827;
    --text-muted: #6b7280;
    --border-color: #e5e7eb;
    --white: #ffffff;
    --radius-card: 12px;
  }


  /* =========================================
     GLOBAL
  ========================================== */

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }


  .catalog-section {
    padding: 2.5rem 0 5rem;
    background: var(--bg-page);
    min-height: 85vh;
  }


  /* =========================================
     TOOLBAR
  ========================================== */

  .catalog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: var(--white);

    padding: 0.85rem 1.25rem;

    border-radius: 12px;
    border: 1px solid var(--border-color);

    margin-bottom: 1.5rem;

    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.02);
  }


  .currency-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }


  .currency-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }


  .currency-group select {
    padding: 0.4rem 0.75rem;

    border-radius: 8px;

    border: 1px solid
      var(--border-color);

    font-weight: 600;

    outline: none;

    background: #fff;

    cursor: pointer;
  }


  /* CART BUTTON */

  .cart-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    background: var(--primary);
    color: var(--white);

    border: none;

    padding: 0.6rem 1.1rem;

    border-radius: 8px;

    font-size: 0.9rem;
    font-weight: 600;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }


  .cart-trigger:hover {
    background:
      var(--primary-hover);

    transform:
      translateY(-1px);
  }


  /* =========================================
     CATEGORY
  ========================================== */

  .category-filter-container {
    margin-bottom: 2rem;

    overflow-x: auto;

    padding-bottom: 0.5rem;
  }


  .category-pills {
    display: flex;
    gap: 0.5rem;

