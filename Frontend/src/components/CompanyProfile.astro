---
import WhatsAppButton from './WhatsAppButton.astro';
---

<div class="company-profile">
  <!-- HERO SECTION -->
  <section id="hero" class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1 data-lang-id="Bahan Baku Alam Dengan Proses Terbaik" data-lang-en="Natural Raw Materials with Best Processing">
        Bahan Baku Alam Dengan Proses Terbaik
      </h1>
      <p data-lang-id="Memproses bahan alam sesuai kebutuhan." data-lang-en="processing natural materials according to needs.">
        Memproses bahan alam sesuai kebutuhan.
      </p>
      <div class="hero-actions">
        <a href="#ingredients" class="btn btn-primary" data-lang-id="Lihat Produk" data-lang-en="View Products">Lihat Produk</a>
        <a href="#contact" class="btn btn-outline-light" data-lang-id="Mulai Konsultasi" data-lang-en="Start Consultation">Mulai Konsultasi</a>
      </div>
    </div>
  </section>

  <!-- INGREDIENTS SECTION (Replacing Vision & Mission) -->
  <section id="ingredients" class="ingredients section-padding">
    <div class="container">
      <div class="section-header">
        <h2 data-lang-id="Produk Bahan Baku" data-lang-en="Our Ingredients">Produk Bahan Baku</h2>
        <p data-lang-id="Rangkaian ekstrak dan olahan bahan alam pilihan berstandar mutu tinggi." data-lang-en="Selected natural extracts and processed ingredients with high quality standards.">
          Rangkaian ekstrak dan olahan bahan alam pilihan berstandar mutu tinggi.
        </p>
      </div>

      <div class="ingredients-grid">
        <!-- Ingredient Item 1 -->
        <div class="ingredient-card">
          <div class="ingredient-img-wrapper">
            <img src="https://images.unsplash.com/photo-1608571702600-5a5419d31475?auto=format&fit=crop&q=80&w=800" alt="Liquid Extracts" loading="lazy" />
          </div>
          <div class="ingredient-info">
            <h3>Ekstrak Cair, Serbuk & Nanopartikel</h3>
            <p data-lang-id="Beragam bentuk ekstrak bahan alam, dari cairan konsentrat, serbuk halus, hingga nanopartikel untuk aplikasi industri." data-lang-en="Various forms of natural extracts, from concentrated liquids, fine powders, to nanoparticles for industrial applications.">
              Beragam bentuk ekstrak bahan alam, dari cairan konsentrat, serbuk halus, hingga nanopartikel untuk aplikasi industri.
            </p>
            <a href="#contact" class="link-detail" data-lang-id="Lihat Lebih Detail" data-lang-en="View Details">Lihat Lebih Detail &rarr;</a>
          </div>
        </div>

        <!-- Ingredient Item 2 -->
        <div class="ingredient-card">
          <div class="ingredient-img-wrapper">
            <img src="https://images.unsplash.com/photo-1486548730767-5c679e8eda6b?auto=format&fit=crop&q=80&w=800" alt="Dried Spices and Powders" loading="lazy" />
          </div>
          <div class="ingredient-info">
            <h3>Rempah Kering & Serbuk</h3>
            <p data-lang-id="Rempah kering pilihan dan serbuk halus untuk kebutuhan industri pangan, minuman, dan kosmetik." data-lang-en="Selected dried spices and fine powders for food, beverage, and cosmetic industries.">
              Rempah kering pilihan dan serbuk halus untuk kebutuhan industri pangan, minuman, dan kosmetik.
            </p>
            <a href="#contact" class="link-detail" data-lang-id="Lihat Lebih Detail" data-lang-en="View Details">Lihat Lebih Detail &rarr;</a>
          </div>
        </div>

        <!-- Ingredient Item 3 -->
        <div class="ingredient-card">
          <div class="ingredient-img-wrapper">
            <img src="https://images.unsplash.com/photo-1621958180509-74e9a29b3758?auto=format&fit=crop&q=80&w=800" alt="Cold Pressed and Vegetable Oils" loading="lazy" />
          </div>
          <div class="ingredient-info">
            <h3>Cold Pressed Oil, Vegetable Oil & Oleoresin</h3>
            <p data-lang-id="Minyak tekan dingin, minyak nabati, dan oleoresin berkualitas untuk berbagai kebutuhan industri." data-lang-en="High-quality cold pressed oils, vegetable oils, and oleoresins for various industrial needs.">
              Minyak tekan dingin, minyak nabati, dan oleoresin berkualitas untuk berbagai kebutuhan industri.
            </p>
            <a href="#contact" class="link-detail" data-lang-id="Lihat Lebih Detail" data-lang-en="View Details">Lihat Lebih Detail &rarr;</a>
          </div>
        </div>

        <!-- Ingredient Item 4 -->
        <div class="ingredient-card">
          <div class="ingredient-img-wrapper">
            <img src="https://images.unsplash.com/photo-1632243575963-3143700087ed?auto=format&fit=crop&q=80&w=800" alt="Aromatherapy Water" loading="lazy" />
          </div>
          <div class="ingredient-info">
            <h3>Aromatherapy Water</h3>
            <p data-lang-id="Hydrosol dan aromatherapy water dari hasil sulingan bahan alam untuk aromaterapi dan kosmetik." data-lang-en="Hydrosols and aromatherapy waters distilled from natural ingredients for aromatherapy and cosmetics.">
              Hydrosol dan aromatherapy water dari hasil sulingan bahan alam untuk aromaterapi dan kosmetik.
            </p>
            <a href="#contact" class="link-detail" data-lang-id="Lihat Lebih Detail" data-lang-en="View Details">Lihat Lebih Detail &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES SECTION -->
  <section id="values" class="values section-padding bg-light">
    <div class="container">
      <div class="section-header">
        <h2 data-lang-id="Core Values" data-lang-en="Core Values">Core Values</h2>
        <p data-lang-id="Prinsip utama kami dalam menghadirkan produk olahan bahan alam terbaik." data-lang-en="Our core principles in delivering the best processed natural ingredients.">
          Prinsip utama kami dalam menghadirkan produk olahan bahan alam terbaik.
        </p>
      </div>
      <div class="grid-4">
        <div class="value-card">
          <h3>Problem Solver</h3>
          <p data-lang-id="Menyediakan solusi bahan alam sesuai dengan tantangan market." data-lang-en="Providing natural ingredient solutions in line with market challenges.">Menyediakan solusi bahan alam sesuai dengan tantangan market.</p>
        </div>
        <div class="value-card">
          <h3>Adaptability</h3>
          <p data-lang-id="Menyediakan produk olahan bahan alam sesuai dengan kebutuhan market." data-lang-en="Providing processed natural products tailored to market needs.">Menyediakan produk olahan bahan alam sesuai dengan kebutuhan market.</p>
        </div>
        <div class="value-card">
          <h3>Quality</h3>
          <p data-lang-id="Menjaga, mengontrol dan memastikan mutu bahan alam sesuai kebutuhan market." data-lang-en="Maintaining, controlling, and ensuring quality according to market standards.">Menjaga, mengontrol dan memastikan mutu bahan alam sesuai kebutuhan market.</p>
        </div>
        <div class="value-card">
          <h3>Innovation</h3>
          <p data-lang-id="Terus berinovasi dalam riset dan teknologi ekstraksi/pengolahan bahan alam." data-lang-en="Continuous innovation in research and extraction technology for natural products.">Terus berinovasi dalam riset dan teknologi ekstraksi/pengolahan bahan alam.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- JOURNEY SECTION -->
  <section id="journey" class="journey section-padding">
    <div class="container">
      <div class="section-header">
        <h2>Our Journey</h2>
        <p data-lang-id="Bagaimana kami tumbuh dan menjaga kepercayaan mitra industri." data-lang-en="How we grow and maintain the trust of industry partners.">Bagaimana kami tumbuh dan menjaga kepercayaan mitra industri.</p>
      </div>
      <div class="grid-3">
        <div class="journey-card">
          <span class="journey-tag">How it Started</span>
          <p data-lang-id="Berawal dari potensi kekayaan sumber daya alam lokal yang melimpah namun memerlukan standar pengolahan modern." data-lang-en="Starting from abundant local natural resource potential that required modern processing standards.">Berawal dari potensi kekayaan sumber daya alam lokal yang melimpah namun memerlukan standar pengolahan modern.</p>
        </div>
        <div class="journey-card">
          <span class="journey-tag">How it Built</span>
          <p data-lang-id="Membangun fasilitas produksi berstandar serta menjalin kemitraan erat dengan para petani lokal." data-lang-en="Building standardized production facilities and establishing close partnerships with local farmers.">Membangun fasilitas produksi berstandar serta menjalin kemitraan erat dengan para petani lokal.</p>
        </div>
        <div class="journey-card">
          <span class="journey-tag">Why Us</span>
          <p data-lang-id="Pengontrolan kualitas yang ketat, sertifikasi lengkap, serta fleksibilitas produk sesuai spesifikasi industri." data-lang-en="Strict quality control, complete certifications, and product flexibility matching industry specifications.">Pengontrolan kualitas yang ketat, sertifikasi lengkap, serta fleksibilitas produk sesuai spesifikasi industri.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section id="process" class="process section-padding bg-light">
    <div class="container">
      <div class="section-header">
        <h2 data-lang-id="Proses & Dampak" data-lang-en="Process & Impact">Proses & Dampak</h2>
        <p data-lang-id="Alur pengelolaan terpadu dari hulu ke hilir." data-lang-en="Integrated management flow from upstream to downstream.">Alur pengelolaan terpadu dari hulu ke hilir.</p>
      </div>
      <div class="grid-4">
        <div class="process-card">
          <span class="step-num">01</span>
          <h3>Seeding</h3>
          <p data-lang-id="Pemilihan benih dan bahan baku terbaik langsung dari sumbernya." data-lang-en="Selecting the best seeds and raw materials directly from the source.">Pemilihan benih dan bahan baku terbaik langsung dari sumbernya.</p>
        </div>
        <div class="process-card">
          <span class="step-num">02</span>
          <h3>Harvesting</h3>
          <p data-lang-id="Panen dilakukan pada masa optimal untuk menjaga mutu nutrisi/kandungan." data-lang-en="Harvesting at optimal timing to preserve active compound and nutrient quality.">Panen dilakukan pada masa optimal untuk menjaga mutu nutrisi/kandungan.</p>
        </div>
        <div class="process-card">
          <span class="step-num">03</span>
          <h3>Processing</h3>
          <p data-lang-id="Pengolahan awal higienis dengan kontrol standar keamanan pangan." data-lang-en="Hygienic initial processing under food safety standards control.">Pengolahan awal higienis dengan kontrol standar keamanan pangan.</p>
        </div>
        <div class="process-card">
          <span class="step-num">04</span>
          <h3>Manufacturing</h3>
          <p data-lang-id="Proses ekstraksi & manufaktur modern siap pakai untuk industri." data-lang-en="Modern extraction & manufacturing process ready for industrial use.">Proses ekstraksi & manufaktur modern siap pakai untuk industri.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS SECTION (Image Gallery Only) -->
  <section id="certifications" class="certifications section-padding">
    <div class="container text-center">
      <div class="section-header">
        <h2 data-lang-id="Sertifikasi & Mutu Terjamin" data-lang-en="Certifications & Guaranteed Quality">Sertifikasi & Mutu Terjamin</h2>
        <p data-lang-id="Memenuhi standar kualitas industri nasional dan internasional." data-lang-en="Meeting national and international industry quality standards.">Memenuhi standar kualitas industri nasional dan internasional.</p>
      </div>
      
      <div class="cert-grid">
        <div class="cert-item"><img src="https://placehold.co/180x80/f8faf9/1b4332?text=ISO+22000" alt="ISO 22000 Certification" /></div>
        <div class="cert-item"><img src="https://placehold.co/180x80/f8faf9/1b4332?text=HACCP" alt="HACCP Certification" /></div>
        <div class="cert-item"><img src="https://placehold.co/180x80/f8faf9/1b4332?text=GMP+Certified" alt="GMP Certification" /></div>
        <div class="cert-item"><img src="https://placehold.co/180x80/f8faf9/1b4332?text=USDA+Organic" alt="USDA Organic Certification" /></div>
        <div class="cert-item"><img src="https://placehold.co/180x80/f8faf9/1b4332?text=HALAL" alt="Halal Certification" /></div>
      </div>
    </div>
  </section>

  <WhatsAppButton phoneNumber="62823451417" />
</div>

<style>
  :root {
    --primary: #2d6a4f;
    --primary-dark: #1b4332;
    --primary-light: #52b788;
    --text-dark: #111827;
    --text-muted: #4b5563;
    --bg-light: #f9fafb;
    --white: #ffffff;
    --border: #e5e7eb;
    --radius: 6px;
  }

  html { scroll-behavior: smooth; }

  .company-profile {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-dark);
    line-height: 1.6;
    background-color: #fff;
  }

  .container { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
  .section-padding { padding: 6rem 0; }
  .bg-light { background-color: var(--bg-light); }
  .text-center { text-align: center; }

  /* Grid Layouts */
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease-in-out;
  }
  .btn-primary { background-color: var(--primary); color: var(--white); }
  .btn-primary:hover { background-color: var(--primary-dark); }
  .btn-outline-light { border-color: rgba(255, 255, 255, 0.4); color: var(--white); }
  .btn-outline-light:hover { background-color: var(--white); color: var(--primary-dark); }

  /* Minimal Badge */
  .badge {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary-light);
    font-weight: 600;
    font-size: 0.75rem;
    display: inline-block;
    margin-bottom: 1rem;
  }

  /* Section Header */
  .section-header { text-align: center; margin-bottom: 3.5rem; }
  .section-header h2 { font-size: 2.25rem; font-weight: 600; color: var(--primary-dark); margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .section-header p { color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 1.05rem; }

  /* Hero */
  .hero {
    position: relative;
    background: url('https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&q=80&w=1600') center/cover no-repeat;
    color: var(--white);
    padding: 9rem 0 7rem 0;
  }
  .hero-overlay { position: absolute; inset: 0; background: rgba(15, 30, 22, 0.82); }
  .hero-content { position: relative; z-index: 1; max-width: 700px; }
  .hero h1 { font-size: 3.25rem; font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem; letter-spacing: -0.02em; }
  .hero p { font-size: 1.15rem; color: rgba(255, 255, 255, 0.85); margin-bottom: 2.5rem; font-weight: 300; }
  .hero-actions { display: flex; gap: 1rem; }

  /* Ingredients Gallery */
  .ingredients-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .ingredient-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }
  .ingredient-card:hover { border-color: var(--primary-light); }
  .ingredient-img-wrapper { height: 220px; width: 100%; overflow: hidden; background: #eee; }
  .ingredient-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .ingredient-info { padding: 1.75rem; display: flex; flex-direction: column; flex: 1; }
  .ingredient-info h3 { font-size: 1.2rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--primary-dark); }
  .ingredient-info p { font-size: 0.925rem; color: var(--text-muted); margin-bottom: 1.25rem; flex: 1; }
  .link-detail {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    display: inline-block;
  }
  .link-detail:hover { text-decoration: underline; }

  /* Value Cards */
  .value-card {
    background: var(--white);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .value-card h3 { color: var(--primary-dark); margin-bottom: 0.5rem; font-size: 1.1rem; font-weight: 600; }
  .value-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }

  /* Journey Cards */
  .journey-card {
    background: var(--white);
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .journey-tag {
    display: block;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .journey-card p { color: var(--text-muted); font-size: 0.95rem; }

  /* Process Section */
  .process-card {
    background: var(--white);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .step-num { 
    display: block; 
    font-size: 0.85rem; 
    font-weight: 700; 
    color: var(--primary-light); 
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }
  .process-card h3 { margin-bottom: 0.5rem; font-size: 1.1rem; font-weight: 600; }
  .process-card p { font-size: 0.875rem; color: var(--text-muted); }

  /* Certifications Gallery */
  .cert-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 1rem;
  }
  .cert-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.5rem;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cert-item img {
    max-height: 50px;
    width: auto;
    filter: grayscale(100%);
    opacity: 0.75;
    transition: all 0.2s ease;
  }
  .cert-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .ingredients-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .ingredients-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 900px) {
    .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
    .hero { padding: 6rem 0 5rem 0; }
    .hero h1 { font-size: 2.25rem; }
    .section-padding { padding: 4rem 0; }
  }
</style>