---
import HeroSection from './HeroSection.astro';
import IngredientsSection from './IngredientsSection.astro';
import ValuesSection from './ValuesSection.astro';
import JourneySection from './JourneySection.astro';
import ProcessSection from './ProcessSection.astro';
import CertificationsSection from './CertificationsSection.astro';
---

<div class="company-profile">
  <HeroSection />
  <IngredientsSection />
  <ValuesSection />
  <JourneySection />
  <ProcessSection />
  <CertificationsSection />
</div>

<style>
  .company-profile {
    color: var(--text-dark);
    line-height: 1.6;
    background-color: var(--white);
  }
</style>
