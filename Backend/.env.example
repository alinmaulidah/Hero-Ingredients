# ===== Database (MySQL) =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=magna_ingredients
DB_PORT=3306

# ===== Auth Admin (JWT) =====
# Wajib diisi string acak min. 32 karakter. Contoh pembuatan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== Login Google (pelanggan) =====
# Client ID dari Google Cloud Console (OAuth 2.0 Client ID, tipe Web application).
# Sama dengan PUBLIC_GOOGLE_CLIENT_ID di Frontend/.env. Kosongkan bila belum mau
# mengaktifkan "Masuk dengan Google".
GOOGLE_CLIENT_ID=

# ===== Midtrans =====
# Server key dari dashboard Midtrans. Sandbox diawali "SB-Mid-server-",
# produksi diawali "Mid-server-".
MIDTRANS_SERVER_KEY=
# Wajib diisi! Jangan andalkan deteksi prefix saja — ada akun sandbox yang
# key-nya berformat "Mid-...". Isi true/false sesuai dashboard yang dipakai.
MIDTRANS_IS_PRODUCTION=false

# ===== Mode Satu Server (opsional) =====
# Saat produksi, Express juga menyajikan hasil build Frontend sehingga
# website + admin (/admin) + API berada di satu domain/port.
# Isi dengan path folder dist hasil `npm run build` di Frontend.
# Contoh: SERVE_FRONTEND=../Frontend/dist
# Kosongkan bila frontend disajikan terpisah (mis. Nginx).
SERVE_FRONTEND=

# ===== Notifikasi Telegram (pembayaran masuk) =====
# Token bot dari @BotFather (chat BotFather → /newbot).
# Chat id penerima: jalankan `npm run test:telegram` setelah token diisi —
# script akan mendeteksi chat id otomatis dari pesan yang dikirim ke bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Port HTTP server (default 5000). Set 80/8080 saat deploy.
PORT=5000
