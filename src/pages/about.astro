---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Tentang Kami - Natural Ingredients">
  <main class="about-page">
    
    <!-- HERO SECTION -->
    <section class="about-hero">
      <div class="container">
        <span class="badge">Tentang Kami</span>
        <h1>Pelopor Pengolahan & Rantai Pasok Bahan Baku Alam</h1>
        <p>
          Menghubungkan kekayaan hayati lokal dengan standar industri global melalui inovasi pengolahan yang berkelanjutan.
        </p>
      </div>
    </section>

    <!-- PROFIL PERUSAHAAN -->
    <section class="company-overview section-padding">
      <div class="container grid-2">
        <div class="overview-text">
          <h2>Siapa Kami</h2>
          <p>
            <strong>Natural Ingredients</strong> adalah perusahaan terdepan dalam industri rantai pasok dan pengolahan bahan baku alam terpadu. Kami berfokus pada transformasi hasil alam berkualitas tinggi menjadi produk olahan siap pakai untuk industri makanan, minuman, farmasi, kosmetik, dan herbal.
          </p>
          <p>
            Berbasis pada kekuatan sumber daya lokal, kami mengintegrasikan proses dari hulu (petani dan pemanenan) hingga hilir (ekstraksi dan pengolahan berstandar modern) untuk memastikan efisiensi, keamanan, serta mutu yang konsisten.
          </p>
        </div>
        <div class="overview-stats">
          <div class="stat-card">
            <h3>100%</h3>
            <p>Bahan Baku Alam Pilihan</p>
          </div>
          <div class="stat-card">
            <h3>50+</h3>
            <p>Mitra Kelompok Tani Lokal</p>
          </div>
          <div class="stat-card">
            <h3>5+</h3>
            <p>Sertifikasi Standar Mutu</p>
          </div>
          <div class="stat-card">
            <h3>Global</h3>
            <p>Jangkauan Pasar Ekspor & Lokal</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PILAR UTAMA KAMI -->
    <section class="pillars-section section-padding bg-light">
      <div class="container">
        <div class="section-header">
          <h2>Pilar Utama Kami</h2>
          <p>Komitmen kami dalam menjalankan bisnis yang berdampak dan berkelanjutan.</p>
        </div>

        <div class="grid-3">
          <div class="pillar-card">
            <div class="pillar-icon">🌱</div>
            <h3>Keberlanjutan (Sustainability)</h3>
            <p>Kami menerapkan praktik pemanenan yang etis dan ramah lingkungan untuk menjaga kelestarian ekosistem serta ketersediaan rantai pasok jangka panjang.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">🤝</div>
            <h3>Pemberdayaan Lokal</h3>
            <p>Bermitra secara adil dengan petani lokal untuk meningkatkan kesejahteraan komunitas agrikultur serta menjaga standar hasil panen.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">🔬</div>
            <h3>Riset & Inovasi Modern</h3>
            <p>Menggunakan teknologi pengolahan dan ekstraksi mutakhir guna memastikan kandungan aktif bahan alam tetap terjaga maksimal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STANDAR KUALITAS & JAMINAN -->
    <section class="quality-section section-padding">
      <div class="container grid-2 align-center">
        <div class="quality-image">
          <div class="image-box">
            <span>🛡️ Quality & Compliance</span>
          </div>
        </div>
        <div class="quality-text">
          <h2>Jaminan Kualitas & Standar Industri</h2>
          <p>
            Kami memahami pentingnya ketepatan spesifikasi bahan baku dalam skala produksi industri. Oleh karena itu, setiap lot produksi melewati tahapan Quality Control (QC) yang ketat di laboratorium pengujian internal maupun independen.
          </p>
          <ul class="check-list">
            <li>✅ Pengujian parameter organoleptik, kadar air, dan kadar abu.</li>
            <li>✅ Uji cemaran mikroba dan logam berat sesuai standar BPOM/Internasional.</li>
            <li>✅ Traceability (keterlacakan) penuh dari lahan hingga ke tangan mitra.</li>
            <li>✅ Dokumentasi lengkap: Technical Data Sheet (TDS) & Certificate of Analysis (COA).</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="cta-section">
      <div class="container text-center">
        <h2>Siap Menjadi Mitra Industri Anda</h2>
        <p>Tertarik menggunakan bahan baku alam berkualitas kami atau ingin berdiskusi seputar formulasi khusus?</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Hubungi Tim Sales</a>
          <a href="/#certifications" class="btn btn-outline">Lihat Sertifikasi</a>
        </div>
      </div>
    </section>

    <WhatsAppButton phoneNumber="6281230040921" />
  </main>
</Layout>

<style>
  :root {
    --primary: #2d6a4f;
    --primary-dark: #1b4332;
    --primary-light: #52b788;
    --accent: #d8f3dc;
    --bg-light: #f8faf9;
    --text-dark: #1f2937;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --white: #ffffff;
    --radius: 12px;
  }

  .about-page {
    color: var(--text-dark);
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-padding {
    padding: 5rem 0;
  }

  .bg-light {
    background-color: var(--bg-light);
  }

  .text-center {
    text-align: center;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .align-center {
    align-items: center;
  }

  /* HERO */
  .about-hero {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    color: var(--white);
    padding: 6rem 0 5rem 0;
    text-align: center;
  }

  .badge {
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--accent);
    padding: 0.4rem 1.2rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .about-hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    max-width: 800px;
    margin: 0 auto 1rem auto;
    line-height: 1.25;
  }

  .about-hero p {
    font-size: 1.15rem;
    max-width: 650px;
    margin: 0 auto;
    opacity: 0.9;
  }

  /* OVERVIEW & STATS */
  .overview-text h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .overview-text p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .overview-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .stat-card {
    background: var(--bg-light);
    border: 1px solid var(--border);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .stat-card h3 {
    font-size: 2.25rem;
    color: var(--primary);
    margin: 0 0 0.25rem 0;
    font-weight: 800;
  }

  .stat-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 600;
  }

  /* PILARS */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--text-muted);
  }

  .pillar-card {
    background: var(--white);
    padding: 2.5rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s;
  }

  .pillar-card:hover {
    transform: translateY(-5px);
  }

  .pillar-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .pillar-card h3 {
    font-size: 1.2rem;
    color: var(--primary-dark);
    margin-bottom: 0.75rem;
  }

  .pillar-card p {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* QUALITY */
  .quality-image .image-box {
    background: linear-gradient(135deg, var(--accent), #b7e4c7);
    height: 320px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary-dark);
    border: 1px solid #b7e4c7;
  }

  .quality-text h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .quality-text p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li {
    font-size: 0.95rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  /* CTA BANNER */
  .cta-section {
    background-color: var(--primary-dark);
    color: var(--white);
    padding: 4.5rem 0;
  }

  .cta-section h2 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: var(--primary-light);
    color: var(--primary-dark);
  }

  .btn-primary:hover {
    background-color: var(--accent);
  }

  .btn-outline {
    border: 1px solid var(--white);
    color: var(--white);
  }

  .btn-outline:hover {
    background-color: var(--white);
    color: var(--primary-dark);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .grid-2, .grid-3, .overview-stats {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-hero h1 {
      font-size: 2rem;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 300px;
      box-sizing: border-box;
    }
  }
</style>