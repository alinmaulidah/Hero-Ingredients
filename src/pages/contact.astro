---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Hubungi Kami - Natural Ingredients">
  <main class="contact-page">
    <!-- HERO HEADER -->
    <section class="contact-hero">
      <div class="container">
        <h1>Hubungi Kami</h1>
        <p>Mari berdiskusi mengenai kebutuhan bahan baku alam, kerja sama pasokan, atau konsultasi produk untuk bisnis Anda.</p>
      </div>
    </section>

    <!-- MAIN CONTENT SECTION -->
    <section class="contact-section">
      <div class="container grid-2">
        
        <!-- INFORMASI KONTAK -->
        <div class="contact-info">
          <h2>Informasi Perusahaan</h2>
          <p class="info-desc">
            Kami siap membantu menyediakan rantai pasok bahan baku alam berkualitas tinggi dan sesuai standar industri Anda.
          </p>

          <div class="info-list">
            <div class="info-item">
              <div class="icon">📍</div>
              <div>
                <h3>Alamat Kantor & Pabrik</h3>
                <p>Jl. Industri Alam No. 88, Kawasan Industri Terpadu, Jawa Timur, Indonesia</p>
              </div>
            </div>

            <div class="info-item">
              <div class="icon">📞</div>
              <div>
                <h3>Telepon / WhatsApp</h3>
                <p>+62 812 3004 0921</p>
              </div>
            </div>

            <div class="info-item">
              <div class="icon">✉️</div>
              <div>
                <h3>Email Resmi</h3>
                <p>info@naturalingredients.co.id</p>
                <p>sales@naturalingredients.co.id</p>
              </div>
            </div>

            <div class="info-item">
              <div class="icon">⏰</div>
              <div>
                <h3>Jam Operasional</h3>
                <p>Senin - Jumat: 08.00 - 17.00 WIB</p>
                <p>Sabtu: 08.00 - 12.00 WIB</p>
              </div>
            </div>
          </div>
        </div>

        <!-- FORMULIR KONTAK -->
        <div class="contact-form-card">
          <h2>Kirim Pesan</h2>
          <p class="form-desc">Isi formulir di bawah ini dan tim kami akan menghubungi Anda kembali dalam 1x24 jam.</p>

          <form class="contact-form" onsubmit="event.preventDefault(); alert('Terima kasih! Pesan Anda telah terkirim.');">
            <div class="form-group">
              <label for="nama">Nama Lengkap *</label>
              <input type="text" id="nama" placeholder="Masukkan nama Anda" required />
            </div>

            <div class="form-group">
              <label for="email">Email Perusahaan / Pribadi *</label>
              <input type="email" id="email" placeholder="contoh@perusahaan.com" required />
            </div>

            <div class="form-group">
              <label for="telepon">Nomor Telepon / WhatsApp *</label>
              <input type="tel" id="telepon" placeholder="+62 812xxxxxxx" required />
            </div>

            <div class="form-group">
              <label for="market">Kategori Pasar *</label>
              <select id="market" required>
                <option value="">-- Pilih Kategori Pasar --</option>
                <option value="Lokal">Pasar Lokal (Indonesia)</option>
                <option value="Export">Pasar Export (Mancanegara)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="pesan">Pesan / Detail Kebutuhan Bahan Baku *</label>
              <textarea id="pesan" rows="4" placeholder="Jelaskan jenis bahan baku, perkiraan kuantitas, atau spesifikasi yang Anda butuhkan..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Kirim Pesan Sekarang</button>
          </form>
        </div>

      </div>
    </section>

    <!-- WHATSAPP FLOATING BUTTON -->
    <WhatsAppButton phoneNumber="6281230040921" />
  </main>
</Layout>

<style>
  :root {
    --primary: #2d6a4f;
    --primary-dark: #1b4332;
    --primary-light: #52b788;
    --bg-light: #f8faf9;
    --text-dark: #1f2937;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --white: #ffffff;
    --radius: 12px;
  }

  .contact-page {
    background-color: var(--bg-light);
    min-height: 80vh;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HERO HEADER */
  .contact-hero {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    color: var(--white);
    padding: 5rem 0 4rem 0;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .contact-hero p {
    font-size: 1.1rem;
    max-width: 650px;
    margin: 0 auto;
    opacity: 0.9;
  }

  /* SECTION & GRID */
  .contact-section {
    padding: 4rem 0;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
  }

  /* INFORMASI KONTAK */
  .contact-info h2 {
    font-size: 1.75rem;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .info-desc {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-item .icon {
    font-size: 1.5rem;
    background: #e8f5e9;
    padding: 0.6rem;
    border-radius: 8px;
    line-height: 1;
  }

  .info-item h3 {
    font-size: 1rem;
    color: var(--primary-dark);
    margin: 0 0 0.25rem 0;
  }

  .info-item p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* FORM CARD */
  .contact-form-card {
    background: var(--white);
    padding: 2.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  .contact-form-card h2 {
    font-size: 1.5rem;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .form-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-dark);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
  }

  .btn-submit {
    width: 100%;
    background-color: var(--primary);
    color: var(--white);
    border: none;
    padding: 0.85rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-submit:hover {
    background-color: var(--primary-dark);
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 900px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .contact-hero h1 {
      font-size: 2rem;
    }
  }
</style>