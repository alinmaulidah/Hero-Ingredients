---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Hubungi Kami - Natural Ingredients">
  <main class="contact-page">
    <!-- HERO HEADER -->
    <section class="contact-hero">
      <div class="container">
        <h1>Hubungi Kami</h1>
        <p>Mari berdiskusi mengenai kebutuhan bahan baku alam, kerja sama pasokan, atau konsultasi produk untuk bisnis Anda.</p>
      </div>
    </section>

    <!-- MAIN CONTENT SECTION -->
    <section class="contact-section">
      <div class="container grid-2">
        
        <!-- INFORMASI PERUSAHAAN, JAM OPERASIONAL & MAP -->
        <div class="contact-info">
          <h2>Informasi Perusahaan</h2>
          <p class="company-desc">
            Kami siap membantu menyediakan rantai pasok bahan baku alam berkualitas tinggi dan sesuai standar industri Anda.
          </p>

          <div class="info-group">
            <span class="info-label">ALAMAT KANTOR & PABRIK</span>
            <p class="info-value"><strong>Aquila New Factory</strong></p>
            <p class="info-value">Jalan Raya Indramayu, Kabupaten Indramayu, Jawa Barat, Indonesia</p>
          </div>

          <div class="info-group">
            <span class="info-label">KONTAK</span>
            <p class="info-value">Telepon / WA: +62 812 3004 0921</p>
            <p class="info-value">Email: info@naturalingredients.co.id</p>
          </div>

          <div class="info-group">
            <span class="info-label">JAM OPERASIONAL</span>
            <p class="info-value">Senin &ndash; Jumat: 08.00 &ndash; 17.00 WIB</p>
            <p class="info-value">Sabtu: 08.00 &ndash; 12.00 WIB</p>
          </div>

          <!-- EMBED MAPS -->
          <div class="map-box">
            <iframe 
              src="https://maps.google.com/maps?q=Aquila+Indramayu&t=&z=15&ie=UTF8&iwloc=&output=embed" 
              width="100%" 
              height="200" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <a 
              href="https://maps.google.com/maps?vet=10CAAQoqAOahcKEwig-eSMxZqWAxUAAAAAHQAAAAAQBg..i&sca_esv=8a52022686445ba0&pvq=Cg0vZy8xMWp5bDlkaDVrIgwKBmFxdWlsYRACGAM&lqi=ChBhcXVpbGEgaW5kcmFtYXl1SLH52KT2sICACFoYEAAYABgBIhBhcXVpbGEgaW5kcmFtYXl1kgESY29zbWV0aWNzX2luZHVzdHJ5&fvr=1&cs=0&um=1&ie=UTF-8&fb=1&gl=id&sa=X&ftid=0x2e6eb9930bbc50e3:0x80b295fb0705270b" 
              target="_blank" 
              class="map-btn">
              Buka di Google Maps &rarr;
            </a>
          </div>
        </div>

        <!-- FORMULIR KONTAK -->
        <div class="contact-form-card">
          <h2>Kirim Pesan</h2>
          <p class="form-desc">Isi formulir di bawah ini dan tim kami akan merespons dalam 1x24 jam.</p>

          <form class="contact-form" onsubmit="event.preventDefault(); alert('Terima kasih! Pesan Anda telah terkirim.');">
            <div class="form-group">
              <label for="nama">Nama Lengkap *</label>
              <input type="text" id="nama" placeholder="Masukkan nama Anda" required />
            </div>

            <div class="form-group">
              <label for="email">Email Perusahaan / Pribadi *</label>
              <input type="email" id="email" placeholder="contoh@perusahaan.com" required />
            </div>

            <div class="form-group">
              <label for="telepon">Nomor Telepon / WhatsApp *</label>
              <input type="tel" id="telepon" placeholder="+62 812xxxxxxx" required />
            </div>

            <div class="form-group">
              <label for="market">Kategori Pasar *</label>
              <select id="market" required>
                <option value="">-- Pilih Kategori Pasar --</option>
                <option value="Lokal">Pasar Lokal (Indonesia)</option>
                <option value="Export">Pasar Export (Mancanegara)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="pesan">Pesan / Detail Kebutuhan Bahan Baku *</label>
              <textarea id="pesan" rows="4" placeholder="Jelaskan jenis bahan baku, perkiraan kuantitas, atau spesifikasi yang Anda butuhkan..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Kirim Pesan Sekarang</button>
          </form>
        </div>

      </div>
    </section>

    <!-- WHATSAPP FLOATING BUTTON -->
    <WhatsAppButton phoneNumber="6281230040921" />
  </main>
</Layout>

<style>
  :root {
    --primary: #2d6a4f;
    --primary-dark: #1b4332;
    --bg-light: #f8faf9;
    --text-dark: #1f2937;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --white: #ffffff;
    --radius: 10px;
  }

  .contact-page {
    background-color: var(--bg-light);
    min-height: 80vh;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HERO HEADER */
  .contact-hero {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    color: var(--white);
    padding: 3.5rem 0 3rem 0;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }

  .contact-hero p {
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
    line-height: 1.5;
  }

  /* SECTION & GRID */
  .contact-section {
    padding: 3rem 0;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* INFORMASI PERUSAHAAN */
  .contact-info h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .company-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .info-group {
    margin-bottom: 1.2rem;
  }

  .info-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .info-value {
    font-size: 0.9rem;
    color: var(--text-dark);
    margin: 0 0 0.2rem 0;
    line-height: 1.4;
  }

  /* MAP BOX */
  .map-box {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--white);
  }

  .map-box iframe {
    display: block;
  }

  .map-btn {
    display: block;
    text-align: center;
    padding: 0.6rem;
    background: var(--white);
    color: var(--primary-dark);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border-top: 1px solid var(--border);
    transition: background 0.2s;
  }

  .map-btn:hover {
    background: #e8f5e9;
  }

  /* FORM CARD */
  .contact-form-card {
    background: var(--white);
    padding: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .contact-form-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-dark);
    margin-bottom: 0.25rem;
  }

  .form-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.2rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-dark);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
  }

  .btn-submit {
    width: 100%;
    background-color: var(--primary);
    color: var(--white);
    border: none;
    padding: 0.8rem;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-submit:hover {
    background-color: var(--primary-dark);
  }

  /* RESPONSIVE */
  @media (max-width: 800px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-hero h1 {
      font-size: 1.75rem;
    }
  }
</style>