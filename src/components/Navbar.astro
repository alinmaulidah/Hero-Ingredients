---
// Mendapatkan path halaman saat ini untuk memberikan efek status active di menu
const currentPath = Astro.url.pathname;
---

<header class="navbar">
  <div class="container nav-container">
    <!-- LOGO WEBSITE -->
    <a href="/" class="nav-logo">
  <span class="logo-main">MAGNA</span>
  <span class="logo-sub">INGREDIENTS</span>
</a>

    <!-- NAV MENU -->
    <nav class="nav-menu">
      <a 
        href="/" 
        class={`nav-link ${currentPath === '/' ? 'active' : ''}`}
        data-lang-id="Beranda" 
        data-lang-en="Home"
      >
        Beranda
      </a>
      <a 
        href="/about" 
        class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}
        data-lang-id="Tentang Kami" 
        data-lang-en="About Us"
      >
        Tentang Kami
      </a>
      <a 
        href="/products" 
        class={`nav-link ${currentPath.startsWith('/products') ? 'active' : ''}`}
        data-lang-id="Produk" 
        data-lang-en="Products"
      >
        Produk
      </a>
      <a 
        href="/contact" 
        class={`nav-link ${currentPath.startsWith('/contact') ? 'active' : ''}`}
        data-lang-id="Kontak" 
        data-lang-en="Contact"
      >
        Kontak
      </a>
    </nav>
    <!-- RIGHT ACTIONS (BAHASA ID / EN) -->
    <div class="nav-actions">
      <div class="lang-switcher">
        <button id="btn-id" class="lang-btn active" type="button" aria-label="Bahasa Indonesia">
          <svg class="flag-img" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip-id)">
              <rect width="32" height="16" fill="#e70011"/>
              <rect y="16" width="32" height="16" fill="#ffffff"/>
            </g>
            <defs>
              <clipPath id="clip-id"><circle cx="16" cy="16" r="16"/></clipPath>
            </defs>
          </svg>
          <span class="lang-code">ID</span>
        </button>

        <button id="btn-en" class="lang-btn" type="button" aria-label="English">
          <svg class="flag-img" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip-uk)">
              <rect width="32" height="32" fill="#012169"/>
              <path d="M0,0 L32,32 M32,0 L0,32" stroke="#ffffff" stroke-width="4"/>
              <path d="M0,0 L32,32 M32,0 L0,32" stroke="#C8102E" stroke-width="2"/>
              <path d="M16,0 V32 M0,16 H32" stroke="#ffffff" stroke-width="6"/>
              <path d="M16,0 V32 M0,16 H32" stroke="#C8102E" stroke-width="3.5"/>
            </g>
            <defs>
              <clipPath id="clip-uk"><circle cx="16" cy="16" r="16"/></clipPath>
            </defs>
          </svg>
          <span class="lang-code">EN</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const btnId = document.getElementById('btn-id');
  const btnEn = document.getElementById('btn-en');

  function setLanguage(lang: 'id' | 'en') {
    if (lang === 'id') {
      btnId?.classList.add('active');
      btnEn?.classList.remove('active');
    } else {
      btnEn?.classList.add('active');
      btnId?.classList.remove('active');
    }

    document.querySelectorAll('[data-lang-id]').forEach((el) => {
      const text = el.getAttribute(`data-lang-${lang}`);
      if (text) {
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
          (el as HTMLInputElement).placeholder = text;
        } else {
          el.textContent = text;
        }
      }
    });

    localStorage.setItem('preferred-lang', lang);
  }

  btnId?.addEventListener('click', () => setLanguage('id'));
  btnEn?.addEventListener('click', () => setLanguage('en'));

  const savedLang = (localStorage.getItem('preferred-lang') as 'id' | 'en') || 'id';
  setLanguage(savedLang);
</script>

<style>
  :root {
    --nav-primary: #2d6a4f;
    --nav-dark: #1b4332;
    --nav-text: #374151;
    --nav-bg: rgba(255, 255, 255, 0.95);
    --pill-bg: #e2e8f0;
  }

  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--nav-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 1000;
    height: 72px;
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* LOGO ELEGAN, SIMPEL, DAN MODERN */
.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  text-decoration: none;
  line-height: 1;
}

.logo-main {
  font-size: 1.15rem;
  font-weight: 800;
  color: #1b4332; /* Hijau gelap elegan */
  letter-spacing: 1.5px; /* Jarak antar huruf agar terkesan premium */
  text-transform: uppercase;
}

.logo-sub {
  font-size: 1.15rem;
  font-weight: 300; /* Font tipis untuk kontras yang seimbang */
  color: #2d6a4f; /* Hijau natural */
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

/* Efek hover halus pada logo */
.nav-logo:hover .logo-sub {
  color: #52b788;
  transition: color 0.3s ease;
}

  /* NAV MENU */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--nav-text);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--nav-primary);
    font-weight: 600;
  }

  /* Garis bawah penanda halaman aktif */
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--nav-primary);
    border-radius: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  /* LANGUAGE SWITCHER PILL */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background-color: var(--pill-bg);
    padding: 3px;
    border-radius: 999px;
    gap: 2px;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: none;
    background: transparent;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .flag-img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .lang-code {
    letter-spacing: 0.2px;
  }

  .lang-btn.active {
    background-color: #ffffff;
    color: #334155;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 768px) {
    .nav-menu {
      gap: 1rem;
    }
    .nav-link {
      font-size: 0.85rem;
    }
  }
</style>